# ── Taurus Dashboard – configuration ──────────────────────────────────────
# Copier ce fichier en `.env` puis renseigner les valeurs.
# Aucune clé n'est OBLIGATOIRE : le dashboard fonctionne sur les sources
# gratuites (SEC EDGAR + Kenneth French + Yahoo Finance). Les clés ci-dessous
# améliorent la couverture et la fiabilité.

# Financial Modeling Prep — https://site.financialmodelingprep.com/developer
# Utilisé en priorité pour les prix et les fondamentaux si présent.
FMP_API_KEY=

# User-Agent envoyé à SEC EDGAR (la SEC exige un contact identifiable).
TAURUS_SEC_USER_AGENT=Taurus Dashboard contact@example.com

# Durée de vie du cache disque, en heures.
TAURUS_CACHE_TTL_HOURS=12

# Répertoire du cache disque.
TAURUS_CACHE_DIR=.cache
